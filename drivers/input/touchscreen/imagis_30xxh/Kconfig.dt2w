#
# Imagis IST30XXH Touchscreen D2TW support
#

config TOUCHSCREEN_IST30XXH_DT2W_SUPPORT
	bool "Firmware-assisted double tap to wake"
	default y
	depends on TOUCHSCREEN_IST30XXH
	help
	  Enable double tap to wake by default using the controller's low-power
	  AOD double-tap event and a wake-capable IRQ. Requires touch firmware
	  that implements this gesture. No software tap detector or polling is
	  used. The factory double_tap command can disable/enable it while the
	  screen is on; changes take effect at the next screen-off transition.
